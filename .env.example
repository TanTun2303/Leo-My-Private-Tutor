# ── Identity & access ────────────────────────────────────────────
COMPOSE_PROJECT_NAME=leo
TZ=Asia/Seoul
LEO_DOMAIN=leo.localhost          # resolves to 127.0.0.1 in modern browsers
LEO_BIND_ADDR=127.0.0.1           # 0.0.0.0 to allow LAN access
LEO_HTTPS_PORT=443
LEO_HTTP_PORT=80
LEO_DATA_DIR=./data
# Remote access: Caddy serves https://<LEO_PUBLIC_HOST>:<LEO_PUBLIC_PORT> (tls internal).
# 127.0.0.1 = off; 0.0.0.0 = reachable from every network this host is on (the internet here!).
LEO_PUBLIC_BIND=127.0.0.1
LEO_PUBLIC_PORT=8442
LEO_PUBLIC_HOST=127.0.0.1
LEO_TAILSCALE_HOST=127.0.0.2          # also served on https://<this>:8442 (Tailscale)
# LEO_DEFAULT_SNI: IP whose certificate browsers get (they send no SNI for IPs)
LEO_DEFAULT_SNI=
LEO_PUBLIC_URL=

# ── Public edge (nginx + Let's Encrypt), enabled by COMPOSE_PROFILES=edge ──
COMPOSE_PROFILES=
LEO_EDGE_DOMAIN=leo.example.com               # DNS A record must point at LEO_EDGE_BIND
LEO_EDGE_BIND=127.0.0.1                       # public address nginx listens on (ports 80 + 443)
# LEO_EDGE_EMAIL: optional: Let's Encrypt expiry notices
LEO_EDGE_EMAIL=
LEO_EDGE_STAGING=false                        # true = test certificates (no rate limits)

# ── Pinned versions (resolved 2026-09-25) ────────────────────────
OPENWEBUI_VERSION=v0.11.4                 # ghcr.io/open-webui/open-webui:<tag>
LLAMACPP_CUDA_TAG=server-cuda12-b11176    # ghcr.io/ggml-org/llama.cpp (CUDA 12 — safest for Ampere)
LLAMACPP_CPU_TAG=server-b11176            # same build number
PGVECTOR_TAG=0.8.6-pg17-bookworm          # pgvector/pgvector:<tag>
SEARXNG_VERSION=2026.9.25-487f51922
CADDY_VERSION=2.11.4-alpine
NGINX_VERSION=1.31.6-alpine
CERTBOT_VERSION=v5.8.0
PLAYWRIGHT_TAG=v1.63.0-noble              # mcr.microsoft.com/playwright/python:<tag>
PYTHON_VERSION=3.12

# ── Admin (applied on first boot only) ───────────────────────────
WEBUI_ADMIN_EMAIL=you@example.com
WEBUI_ADMIN_NAME=Owner
WEBUI_ADMIN_PASSWORD=__GENERATE__

# ── Secrets ─────────────────────────────────────────────────────
WEBUI_SECRET_KEY=__GENERATE__
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
OPENWEBUI_DB_PASSWORD=__GENERATE__
LEO_MEMORY_DB_PASSWORD=__GENERATE__
LEO_RECONCILE_DB_PASSWORD=__GENERATE__
LLM_API_KEY=__GENERATE__
EMBED_API_KEY=__GENERATE__
LEO_MEMORY_TOKEN=__GENERATE__
SEARXNG_SECRET=__GENERATE__

# ── Leo model ───────────────────────────────────────────────────
LEO_MODEL_REPO=unsloth/Qwen3.6-35B-A3B-GGUF
LEO_MODEL_FILE=Qwen3.6-35B-A3B-UD-IQ4_XS.gguf   # 17.7 GB — verified by fetch-models.sh
#   alternatives: UD-Q4_K_M (22.1 GB, slightly better, slower) · UD-IQ3_XXS (13.2 GB, fastest; A/B only)
LEO_MMPROJ_FILE=mmproj-F16.gguf                 # vision projector; empty = no vision
LEO_MMPROJ_ON_GPU=false                         # keep the vision encoder on CPU → more VRAM for experts
LEO_N_CPU_MOE=20                                # tuned on RTX 3080 Ti (docs/TUNING.md)
LEO_CTX=65536
LEO_PARALLEL=2                                  # slot 1: you; slot 2: background tasks
LEO_THREADS=6                                   # physical cores
LEO_UBATCH=2048                                 # tuned (docs/TUNING.md)
LEO_THINK_DEFAULT=false                         # fast by default; 🧠 Think enables reasoning per request
LEO_REASONING_BUDGET=4096                       # max thinking tokens when Think is on
LEO_MTP=false                                   # speculative decoding; `make tune` decides
LEO_MTP_DRAFT_MAX=2
LEO_EXTRA_ARGS=

# ── Math rendering ──────────────────────────────────────────────
LEO_MATH_INLINE=dollar            # dollar = $…$ · paren = \(…\) · double = $$…$$
LEO_MATH_STREAM_NORMALIZE=true

# ── Embeddings (CPU) ────────────────────────────────────────────
EMBED_MODEL_REPO=Qwen/Qwen3-Embedding-0.6B-GGUF
EMBED_MODEL_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf
EMBED_DIM=1024
EMBED_THREADS=4

# ── RAG ─────────────────────────────────────────────────────────
RAG_RERANKING_MODEL=BAAI/bge-reranker-v2-m3
RAG_TOP_K=8
RAG_TOP_K_RERANKER=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ── Memory ──────────────────────────────────────────────────────
MEMORY_IDLE_SECONDS=120
MEMORY_MAX_WAIT_SECONDS=900
MEMORY_SUMMARY_MAX_WORDS=60
MEMORY_RECALL_TOP_K=3
MEMORY_MAX_INJECT_CHARS=1500
MEMORY_MAX_INPUT_CHARS=24000
MEMORY_RETENTION_DAYS=0          # 0 = keep forever

# ── Library ingest ──────────────────────────────────────────────
INGEST_CONVERTER=marker          # marker | mineru
INGEST_MARKER_MODE=balanced      # balanced | fast
INGEST_WORKERS=3                 # chapters converted in parallel (≈1.4× on this machine)
LEO_KNOWLEDGE_NAME=Leo Library
